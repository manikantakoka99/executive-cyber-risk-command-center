# Local Docker Postgres (default)
DATABASE_URL=postgresql://ecc:ecc_dev_password@localhost:5433/cyber_command_center

# Supabase — paste Project Settings → Database → Connection string → URI
# (Session pooler or Direct). URL-encode special characters in the password.
# Example:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Optional alias used by db/migrate_to_supabase.py:
# SUPABASE_DB_URL=

PORT=4000
CORS_ORIGIN=http://localhost:5173
# true: local QA may call the API with X-Org-Id and X-User-Id (npm test, clean-install).
# false: only the session cookie authenticates. Use false outside local QA.
DEMO_AUTH=true
# Local demo password for `npm run auth:seed` in server/. Placeholder only.
# Do not commit a real value. The script refuses this placeholder.
ECC_DEMO_PASSWORD=replace-with-a-local-password
DEFAULT_RISK_APPETITE=50
DEFAULT_ORG_ID=2accc7de-f693-4b19-8fe8-6db501be05e2
