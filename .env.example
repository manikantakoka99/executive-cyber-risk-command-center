# Local Docker Postgres (default host port 5433)
DATABASE_URL=postgresql://ecc:ecc_dev_password@localhost:5433/cyber_command_center

# Optional alias used by db/migrate_to_supabase.py and server/src/db.ts
# SUPABASE_DB_URL=

# API listen address (server/src/index.ts)
PORT=4000
# HOST=0.0.0.0

# Browser origin(s), comma-separated (server/src/index.ts)
CORS_ORIGIN=http://localhost:5173

# true: local QA may call the API with X-Org-Id and X-User-Id (npm test, clean-install).
# false: only the session cookie authenticates. Use false outside local QA.
# Read by server/src/middleware/tenant.ts
DEMO_AUTH=true

# Local demo passwords for `npm run auth:seed` in server/ (server/scripts/seed_auth.ts).
# Prefer a gitignored file (copy logins.example.csv). One email,password line per role login.
# ECC_DEMO_LOGINS_FILE=../logins.csv
# Fallback when the file is unset: the same password for every role login.
# Do not commit a real value. The script refuses this placeholder.
ECC_DEMO_PASSWORD=replace-with-a-local-password

# Failed sign-in throttle (server/src/auth/loginThrottle.ts). In-process only.
# LOGIN_THROTTLE_EMAIL=8
# LOGIN_THROTTLE_IP=30

# Exact number of reverse proxies in front of the API for login throttle IP.
# Read by server/src/auth/loginThrottle.ts as a positive integer hop count only.
# 1 = one load balancer / reverse proxy. Unset or 0 when clients hit the API directly.
# Never set to true (non-integers are ignored and trust zero hops).
# This does not enable Fastify trustProxy.
# TRUST_PROXY=

# Default risk appetite percent (server/src/services/overview.ts)
DEFAULT_RISK_APPETITE=50

# Org targeted by `npm run demo:seed` / demo CLI (server/scripts/ecc_demo.ts)
DEFAULT_ORG_ID=2accc7de-f693-4b19-8fe8-6db501be05e2
# DEMO_ORG_ID=   # optional alias; wins over DEFAULT_ORG_ID when set

# Optional: set to false to disable sample workbook ingestion routes
# (server/src/index.ts, server/src/services/sampleWorkbookIngestion.ts)
# ECC_ENABLE_SAMPLE_INGESTION=true

# Optional Postgres pool size (server/src/db.ts)
# PG_POOL_MAX=20

# Optional comma-separated role codes that may accept risk (server/src/command/rbac.ts)
# ACCEPT_RISK_ROLES=
