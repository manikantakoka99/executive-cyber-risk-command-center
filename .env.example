# Local Docker Postgres (default)
DATABASE_URL=postgresql://ecc:ecc_dev_password@localhost:5433/cyber_command_center

# Supabase — paste Project Settings → Database → Connection string → URI
# (Session pooler or Direct). URL-encode special characters in the password.
# Example:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Optional alias used by db/migrate_to_supabase.py:
# SUPABASE_DB_URL=

PORT=4000
CORS_ORIGIN=http://localhost:5173
# true: local QA may call the API with X-Org-Id and X-User-Id (npm test, clean-install).
# false: only the session cookie authenticates. Use false outside local QA.
DEMO_AUTH=true
# Local demo passwords for `npm run auth:seed` in server/. Placeholders only.
# Prefer a gitignored file (copy logins.example.csv). One email,password line per role login.
# ECC_DEMO_LOGINS_FILE=../logins.csv
# Fallback when the file is unset: the same password for every role login.
# Do not commit a real value. The script refuses this placeholder.
ECC_DEMO_PASSWORD=replace-with-a-local-password
# Failed sign-ins only. Counters live in the API process (not shared across instances).
# LOGIN_THROTTLE_EMAIL=8
# LOGIN_THROTTLE_IP=30
# Hop count, same as Express trust proxy = N. The socket is the first hop.
# 1 trusts one proxy and uses the rightmost X-Forwarded-For address.
# Unset, 0, false, off, no, and any non-integer ignore the header.
# This does not enable Fastify trustProxy.
# TRUST_PROXY=
DEFAULT_RISK_APPETITE=50
DEFAULT_ORG_ID=2accc7de-f693-4b19-8fe8-6db501be05e2

# Google Authenticator MFA secret encryption key (AES-256-GCM).
# Must be exactly 32 bytes: 64 hexadecimal characters or 44 Base64 characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit real keys to source control. Placeholder only.
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key
